# V2 Engine Environment Configuration
# Copy this file to .env and update values as needed

# PostgreSQL + PostGIS Database
DATABASE_URL=postgresql+asyncpg://ochv2:ochv2_secure_password@localhost:5433/ochv2_geo

# Sync database URL (for scripts that need synchronous access)
DATABASE_URL_SYNC=postgresql://ochv2:ochv2_secure_password@localhost:5433/ochv2_geo

# Redis Cache
REDIS_URL=redis://localhost:6380/0

# OpenAI API Key (for scoring engine - Phase 3)
OPENAI_API_KEY=

# Google Cloud (Phase 2 - GDELT BigQuery)
GOOGLE_APPLICATION_CREDENTIALS=gcp_credentials.json
GCP_PROJECT_ID=ourcityhealth

# Historical data output directory
HISTORICAL_DATA_DIR=data/historical

# Logging
LOG_LEVEL=INFO
